# Copy to backend/.env and fill in as needed (or run: python setup_config.py)

# --- AI (optional) ---
# Without a token the app runs in retrieval-only mode.
# Free token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
AI_TIMEOUT_SECONDS=20

# --- Retrieval ---
TOP_K_SIMILAR=5
MIN_SIMILARITY=0.2
# DATASET_PATH=data/demo_tickets.xlsx

# --- Service ---
PORT=8000
CORS_ORIGINS=*
ADMIN_TOKEN=
